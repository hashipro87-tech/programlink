# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
.pnp
.pnp.js

# ── Secrets — never commit these ──────────────────────────────────────────────
# Real values live in Railway (backend) and Vercel (frontend) env vars.
.env
.env.local
.env.*.local
.env.production
.env.development
# .env.example IS tracked on purpose — it documents required keys with no values.
!.env.example

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── Vite temp files ───────────────────────────────────────────────────────────
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Uploads / local storage ───────────────────────────────────────────────────
uploads/
tmp/
temp/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Testing / coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/
