# ProgramLink Backend — Local Development Environment
# Copy this to .env and adjust for your machine

PORT=4000
NODE_ENV=development

# PostgreSQL — update with your local credentials
DATABASE_URL=postgresql://hashihashi@localhost:5432/programlink

# JWT — change this to any long random string in production
JWT_SECRET=programlink-dev-secret-change-in-production-abc123xyz
JWT_EXPIRES_IN=7d

# Email — leave blank in dev; emails will log to console instead of sending
SENDGRID_API_KEY=
FROM_EMAIL=noreply@programlink.local
FROM_NAME=ProgramLink

# AWS S3 — leave blank to use local disk storage fallback in dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
